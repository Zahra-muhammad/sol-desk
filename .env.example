# Postgres connection string (Neon or Supabase). Use the *pooled* URL on Vercel.
#   Local dev without a database server: DATABASE_URL=pglite:./.data/pglite
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Optional (Neon): the direct, unpooled connection. `npm run db:migrate` prefers it.
DATABASE_URL_UNPOOLED=

# Long random string (32+ chars). Keys the HMAC that session tokens are stored under.
#   Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Anthropic API key for planner.chat (server only — never sent to the browser).
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=claude-sonnet-5-5
